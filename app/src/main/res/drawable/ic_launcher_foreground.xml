<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Accretion disk: wide glowing ellipse behind the horizon -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="-24">
        <path android:strokeWidth="7" android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="sweep"
                    android:centerX="54" android:centerY="54">
                    <item android:offset="0.0" android:color="#4FD2FF" />
                    <item android:offset="0.25" android:color="#8A7CFF" />
                    <item android:offset="0.5" android:color="#1B2340" />
                    <item android:offset="0.75" android:color="#8A7CFF" />
                    <item android:offset="1.0" android:color="#4FD2FF" />
                </gradient>
            </aapt:attr>
            <aapt:attr name="android:pathData">
                <path android:pathData="M54,37.5 a31,16.5 0,1 1,-0.01 0 z" />
            </aapt:attr>
        </path>
    </group>

    <!-- Event horizon: pure dark disk -->
    <path android:pathData="M54,54 m-16,0 a16,16 0,1 1,32 0 a16,16 0,1 1,-32 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="54" android:centerY="54" android:gradientRadius="17">
                <item android:offset="0.0" android:color="#FF000000" />
                <item android:offset="0.82" android:color="#FF000000" />
                <item android:offset="1.0" android:color="#FF0B1020" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Photon ring: bright thin halo hugging the horizon -->
    <path
        android:pathData="M54,54 m-17,0 a17,17 0,1 1,34 0 a17,17 0,1 1,-34 0"
        android:strokeWidth="1.6"
        android:strokeColor="#BFE9FF" />
</vector>
