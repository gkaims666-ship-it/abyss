<?xml version="1.0" encoding="utf-8"?>
<!--
  Abyss mark as an adaptive icon foreground — the same black hole that's drawn
  on the start screen: halo, tilted accretion disk (Doppler-bright on the left),
  gravitational-lensing arc over the horizon, dark event horizon, photon ring,
  front half of the disk crossing in front, and a hot spot.
  Viewport 108; everything important sits inside the 66dp safe circle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Halo -->
    <path android:pathData="M54,54m-34,0a34,34 0,1 1,68 0a34,34 0,1 1,-68 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="54" android:gradientRadius="34">
                <item android:offset="0.0" android:color="#5C53D7FF" />
                <item android:offset="0.45" android:color="#2E7C8CFF" />
                <item android:offset="1.0" android:color="#0053D7FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Back half of the disk (full ellipse, the front half is drawn again on top) -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="-22">
        <path
            android:pathData="M24,54 a30,10.9 0,1 0,60 0 a30,10.9 0,1 0,-60 0"
            android:strokeWidth="4.6"
            android:fillColor="#00000000">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear" android:startX="24" android:startY="54" android:endX="84" android:endY="54">
                    <item android:offset="0.0" android:color="#FFFFFFFF" />
                    <item android:offset="0.3" android:color="#FF53D7FF" />
                    <item android:offset="0.7" android:color="#CC7C8CFF" />
                    <item android:offset="1.0" android:color="#807C8CFF" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- inner band -->
        <path
            android:pathData="M43.2,54 a10.8,3.4 0,1 0,21.6 0 a10.8,3.4 0,1 0,-21.6 0"
            android:strokeWidth="1.6"
            android:strokeColor="#737C8CFF"
            android:fillColor="#00000000" />
    </group>

    <!-- Gravitational lensing: far side of the disk bent over the horizon -->
    <path
        android:pathData="M31.6,50.5 A22.6,21 0 0,1 76.4,50.5"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="31.6" android:startY="40" android:endX="76.4" android:endY="40">
                <item android:offset="0.0" android:color="#267C8CFF" />
                <item android:offset="0.5" android:color="#E653D7FF" />
                <item android:offset="1.0" android:color="#267C8CFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Event horizon -->
    <path
        android:pathData="M54,54m-16,0a16,16 0,1 1,32 0a16,16 0,1 1,-32 0"
        android:fillColor="#FF020306" />

    <!-- Photon ring -->
    <path
        android:pathData="M54,54m-17.1,0a17.1,17.1 0,1 1,34.2 0a17.1,17.1 0,1 1,-34.2 0"
        android:strokeWidth="1.8"
        android:strokeColor="#E67C8CFF"
        android:fillColor="#00000000" />
    <path
        android:pathData="M54,54m-17.1,0a17.1,17.1 0,1 1,34.2 0a17.1,17.1 0,1 1,-34.2 0"
        android:strokeWidth="0.5"
        android:strokeColor="#59FFFFFF"
        android:fillColor="#00000000" />

    <!-- Front half of the disk crossing in front of the horizon + hot spot -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="-22">
        <path
            android:pathData="M24,54 a30,10.9 0,0 0,60 0"
            android:strokeWidth="4.6"
            android:fillColor="#00000000">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear" android:startX="24" android:startY="54" android:endX="84" android:endY="54">
                    <item android:offset="0.0" android:color="#FFFFFFFF" />
                    <item android:offset="0.3" android:color="#FF53D7FF" />
                    <item android:offset="0.7" android:color="#CC7C8CFF" />
                    <item android:offset="1.0" android:color="#807C8CFF" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- hot spot, front-right on the disk -->
        <path android:pathData="M76.9,61m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="76.9" android:centerY="61" android:gradientRadius="6">
                    <item android:offset="0.0" android:color="#F2FFFFFF" />
                    <item android:offset="0.4" android:color="#9953D7FF" />
                    <item android:offset="1.0" android:color="#0053D7FF" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
